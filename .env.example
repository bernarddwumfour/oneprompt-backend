# Django
SECRET_KEY=change-me-generate-a-real-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Identity Services OAuth 2.0 web client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000

# Leave DATABASE_URL empty to use local SQLite. Set it to switch to Postgres,
# e.g. postgres://user:password@localhost:5432/oneprompt
DATABASE_URL=

# Defaults to SECRET_KEY if left empty
JWT_SECRET_KEY=

# --- Plan 0002: Real providers (leave empty until keys are ready) ---
# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Qwen via Alibaba Cloud Model Studio international endpoint
QWEN_API_KEY=
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1

# --- Plan 0005: Test/live mode + Gemini, Claude, ChatGPT (scaffolded, no keys yet) ---
# Gemini via Google's OpenAI-compatible endpoint
GEMINI_API_KEY=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# OpenAI (ChatGPT)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude) — official SDK, base URL optional (defaults to Anthropic's endpoint)
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Cloudflare Workers AI — powers the free default Llama route
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1

# --- Plan 0002: Paystack payments ---
# Test keys from https://dashboard.paystack.com
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

FRONTEND_URL=http://localhost:3000

# --- Plan 0003: Bootstrap admin ---
# If both email and password are set, an admin account is automatically
# created (once) the next time `manage.py migrate` runs, if one with this
# email doesn't already exist. Leave DJANGO_ADMIN_PASSWORD empty to disable.
DJANGO_ADMIN_EMAIL=
DJANGO_ADMIN_PASSWORD=
DJANGO_ADMIN_FULL_NAME=Admin
DJANGO_ADMIN_COUNTRY=GH
